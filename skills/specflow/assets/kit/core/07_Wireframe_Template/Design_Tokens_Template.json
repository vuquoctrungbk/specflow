{
  "primitive": {
    "color": {
      "neutral": {
        "0": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "hex": "#FFFFFF"
          },
          "$description": "fill: raw value of the lightest background color; replace with the color scale of the chosen visual direction"
        },
        "100": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.94902,
              0.94902,
              0.94902
            ],
            "hex": "#F2F2F2"
          },
          "$description": "fill: raw value of the secondary background color"
        },
        "300": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.74902,
              0.74902,
              0.74902
            ],
            "hex": "#BFBFBF"
          },
          "$description": "fill: raw value of the border color"
        },
        "600": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.34902,
              0.34902,
              0.34902
            ],
            "hex": "#595959"
          },
          "$description": "fill: raw value of the secondary text color"
        },
        "900": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.101961,
              0.101961,
              0.101961
            ],
            "hex": "#1A1A1A"
          },
          "$description": "fill: raw value of the primary text color"
        }
      },
      "accent": {
        "600": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.25098,
              0.25098,
              0.25098
            ],
            "hex": "#404040"
          },
          "$description": "fill: raw value of the accent color; replace with the color of the chosen visual direction"
        }
      }
    },
    "space": {
      "0": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$description": "fill: zero spacing"
      },
      "1": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$description": "fill: smallest spacing step"
      },
      "2": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "fill: small spacing step"
      },
      "3": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "fill: medium spacing step"
      },
      "4": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "fill: large spacing step"
      }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$description": "fill: small corner radius"
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "fill: medium corner radius"
      }
    },
    "font": {
      "family": {
        "base": {
          "$type": "fontFamily",
          "$value": [
            "system-ui",
            "sans-serif"
          ],
          "$description": "fill: primary font family of the chosen visual direction"
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeight",
          "$value": 400,
          "$description": "fill: regular font weight"
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700,
          "$description": "fill: bold font weight"
        }
      },
      "size": {
        "sm": {
          "$type": "dimension",
          "$value": {
            "value": 0.875,
            "unit": "rem"
          },
          "$description": "fill: small font size"
        },
        "md": {
          "$type": "dimension",
          "$value": {
            "value": 1,
            "unit": "rem"
          },
          "$description": "fill: base font size, 1rem equals 16px"
        },
        "lg": {
          "$type": "dimension",
          "$value": {
            "value": 1.5,
            "unit": "rem"
          },
          "$description": "fill: heading font size"
        }
      },
      "line-height": {
        "base": {
          "$type": "number",
          "$value": 1.5,
          "$description": "fill: line-height ratio of body text"
        }
      }
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": {
          "value": 150,
          "unit": "ms"
        },
        "$description": "fill: short motion duration; reduce or remove when the user turns on reduced motion"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "fill: standard motion easing curve"
      }
    }
  },
  "semantic": {
    "color": {
      "background": {
        "default": {
          "$type": "color",
          "$value": "{primitive.color.neutral.0}",
          "$description": "fill: main background of the page"
        },
        "subtle": {
          "$type": "color",
          "$value": "{primitive.color.neutral.100}",
          "$description": "fill: secondary background, for areas that group content"
        }
      },
      "text": {
        "default": {
          "$type": "color",
          "$value": "{primitive.color.neutral.900}",
          "$description": "fill: primary text"
        },
        "muted": {
          "$type": "color",
          "$value": "{primitive.color.neutral.600}",
          "$description": "fill: secondary text"
        },
        "on-action": {
          "$type": "color",
          "$value": "{primitive.color.neutral.0}",
          "$description": "fill: text on the background of the primary action"
        }
      },
      "action": {
        "primary": {
          "$type": "color",
          "$value": "{primitive.color.accent.600}",
          "$description": "fill: background of the primary action"
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "{primitive.color.neutral.300}",
          "$description": "fill: default border"
        }
      },
      "focus": {
        "ring": {
          "$type": "color",
          "$value": "{primitive.color.accent.600}",
          "$description": "fill: border that shows focus"
        }
      }
    },
    "space": {
      "gap": {
        "default": {
          "$type": "dimension",
          "$value": "{primitive.space.2}",
          "$description": "fill: gap between adjacent elements"
        }
      },
      "inset": {
        "default": {
          "$type": "dimension",
          "$value": "{primitive.space.3}",
          "$description": "fill: inner padding of a container"
        }
      }
    },
    "radius": {
      "control": {
        "$type": "dimension",
        "$value": "{primitive.radius.sm}",
        "$description": "fill: corner radius of a control"
      },
      "container": {
        "$type": "dimension",
        "$value": "{primitive.radius.md}",
        "$description": "fill: corner radius of a container"
      }
    },
    "typography": {
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{primitive.font.family.base}",
          "fontSize": "{primitive.font.size.md}",
          "fontWeight": "{primitive.font.weight.regular}",
          "lineHeight": "{primitive.font.line-height.base}"
        },
        "$description": "fill: text style of body content"
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{primitive.font.family.base}",
          "fontSize": "{primitive.font.size.lg}",
          "fontWeight": "{primitive.font.weight.bold}",
          "lineHeight": "{primitive.font.line-height.base}"
        },
        "$description": "fill: text style of headings"
      }
    },
    "shadow": {
      "raised": {
        "$type": "shadow",
        "$value": {
          "color": "{primitive.color.neutral.300}",
          "offsetX": "{primitive.space.0}",
          "offsetY": "{primitive.space.1}",
          "blur": "{primitive.space.2}",
          "spread": "{primitive.space.0}"
        },
        "$description": "fill: shadow of an element raised above the background"
      }
    },
    "motion": {
      "duration": {
        "default": {
          "$type": "duration",
          "$value": "{primitive.duration.fast}",
          "$description": "fill: default motion duration"
        }
      },
      "easing": {
        "default": {
          "$type": "cubicBezier",
          "$value": "{primitive.easing.standard}",
          "$description": "fill: default motion easing curve"
        }
      }
    }
  },
  "component": {
    "button": {
      "background": {
        "$type": "color",
        "$value": "{semantic.color.action.primary}",
        "$description": "fill: background of the button"
      },
      "text": {
        "$type": "color",
        "$value": "{semantic.color.text.on-action}",
        "$description": "fill: text of the button"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.control}",
        "$description": "fill: corner radius of the button"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{semantic.space.inset.default}",
        "$description": "fill: inner padding of the button"
      }
    },
    "field": {
      "background": {
        "$type": "color",
        "$value": "{semantic.color.background.default}",
        "$description": "fill: background of the input field"
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border.default}",
        "$description": "fill: border of the input field"
      }
    }
  }
}
